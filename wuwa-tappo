#!/usr/bin/env bash
# Universal launcher for Wuwa Tappo on Linux.
# Runs in an isolated prefix with patched Wine runtime, 4KB PE memory alignment, and C sidecar.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="${SCRIPT_DIR}/runtime/wine-runtime"

# 1. Determine prefix location
DEFAULT_PFX="/var/mnt/LData/tappo-prefix/pfx"
if [ ! -d "${DEFAULT_PFX}" ]; then
    DEFAULT_PFX="${HOME}/.local/share/wuwa-tappo/prefix"
fi
TAPPO_PREFIX="${WUWA_PREFIX:-${DEFAULT_PFX}}"

# 2. Check Wine runtime
if [ ! -f "${RUNTIME_DIR}/.patched" ]; then
    echo "[wuwa-tappo] Runtime not found or incomplete. Running setup.sh..."
    "${SCRIPT_DIR}/setup.sh"
fi

WINE="${RUNTIME_DIR}/bin/wine"
WINESERVER="${RUNTIME_DIR}/bin/wineserver"
APP_EXE_WIN="C:\\Program Files\\WuwaTappoGlobal\\WuwaTappo.exe"
APP_EXE_UNIX="${TAPPO_PREFIX}/drive_c/Program Files/WuwaTappoGlobal/WuwaTappo.exe"

if [ ! -f "${APP_EXE_UNIX}" ]; then
    echo "[wuwa-tappo] WuwaTappo.exe not found at ${APP_EXE_UNIX}" >&2
    echo "Please ensure the app is installed in the prefix." >&2
    exit 1
fi

# 3. Environment configuration
export WINEPREFIX="${TAPPO_PREFIX}"
export WINEDEBUG=-all
export __NV_X11_DISABLE_EXPLICIT_SYNC=1
export GLIBC_TUNABLES="glibc.malloc.arena_max=2"
export MALLOC_CONF="thp:never"
export WEBVIEW2_DEFAULT_BACKGROUND_COLOR=00000000
export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="--no-sandbox --in-process-gpu --disable-features=CalculateNativeWinOcclusion,DirectComposition,DirectCompositionLayers,WidgetLayering,RendererCodeIntegrity,TouchEvents,TouchSelectionStrategy,DWriteFontProxy --disable-direct-composition-video-overlays --disable-checker-imaging --disable-partial-raster --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-background-timer-throttling --enable-features=RunAllCompositorStagesBeforeDraw"

# 4. Realign PE if updated
python3 "${SCRIPT_DIR}/patches/align_pe.py" "${TAPPO_PREFIX}" >/dev/null 2>&1 || true

# 5. Clean up stale wineserver if dead
"${WINESERVER}" -k >/dev/null 2>&1 || true

# 6. Start C input bridge pipeline in background
BRIDGE_PID=""
if [ -x "${SCRIPT_DIR}/sidecars/tappo_bridge" ] && [ -f "${SCRIPT_DIR}/sidecars/tappo_helper.exe" ]; then
    "${SCRIPT_DIR}/sidecars/tappo_bridge" | "${WINE}" "${SCRIPT_DIR}/sidecars/tappo_helper.exe" &
    BRIDGE_PID=$!
fi

cleanup() {
    echo "[wuwa-tappo] Shutting down..."
    if [ -n "${BRIDGE_PID}" ]; then
        kill -TERM "${BRIDGE_PID}" 2>/dev/null || true
    fi
    "${WINESERVER}" -k 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# 7. Launch Wuwa Tappo
echo "[wuwa-tappo] Starting Wuwa Tappo..."
"${WINE}" "${APP_EXE_WIN}" "$@" || true
